# Copy to .env and fill in.
#
# The TM/SeatGeek/Bandsintown keys are read server-side by the Vite proxy
# (vite.config.js) and never shipped to the browser. The VITE_SUPABASE_* values
# are public (the anon key + project URL) and ARE bundled into the browser app;
# row-level security is what protects the data, not secrecy of these values.

# ---- Supabase (accounts + favorites) ----
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- external event APIs (server-side only) ----
# Ticketmaster Discovery API key — free: https://developer.ticketmaster.com
TM_KEY=

# SeatGeek Platform client_id — free: https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=

# Bandsintown app_id (artist tours; requires registered partner access)
BANDSINTOWN_APP_ID=spotlight-edm
