# Copy to .env and fill in. Keys are read server-side by the Vite proxy
# (vite.config.js) and never shipped to the browser.

# Ticketmaster Discovery API key — free: https://developer.ticketmaster.com
TM_KEY=

# SeatGeek Platform client_id — free: https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=

# Bandsintown app_id (artist tours; requires registered partner access)
BANDSINTOWN_APP_ID=spotlight-edm
